# ---------------------------------------------------------------------------
# Firebase Web SDK — Project settings → General → Your apps → Web app → Config.
# These are public by design; access is controlled by the Firestore/Storage
# security rules in nakjm-crm/firebase/, not by hiding these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK — Project settings → Service accounts → Generate new
# private key. Used only by server routes that create users and set role
# claims. KEEP THIS SECRET; never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# ...or provide the three fields individually instead:
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email/domain of the account bootstrapped as SUPER_ADMIN by `npm run seed`.
SEED_SUPER_ADMIN_EMAIL=admin@nakjminfra.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# Only accounts on this email domain may sign in.
WORKSPACE_DOMAIN=nakjminfra.com
