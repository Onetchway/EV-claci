# Public site origin — drives canonical URLs, sitemap and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.nakjiminfra.com

# Analytics (both optional — omit and the scripts are simply not rendered)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Where the enquiry form posts. Defaults to the Firebase Function rewrite.
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/enquiry

# Server-side mail credentials for the Firebase Function (never NEXT_PUBLIC_)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=connect@nakjiminfra.com
