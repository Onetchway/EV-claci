rules_version = '2';

// Enquiries are written only by the Cloud Function (which uses the Admin SDK
// and bypasses these rules). No client may read or write them directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /enquiries/{document} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
