PORT=5100
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpha_platform
JWT_SECRET=change-this-super-admin-jwt-secret
FRONTEND_URL=http://localhost:3100
NODE_ENV=development

# Base domain for tenant subdomains, e.g. with PLATFORM_BASE_DOMAIN=alpha.app
# a tenant with slug "acme" resolves at acme.alpha.app. Used by
# GET /api/tenants/resolve. Leave unset to only support custom_domain routing.
PLATFORM_BASE_DOMAIN=alpha.app

# Cron: when the daily invoice-generation job runs (24h, server TZ)
INVOICE_JOB_HOUR=2

# SMTP — powers invoice emails to tenant contacts. Optional: without these,
# invoice generation still works, emails are just skipped (logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Postgres admin connection used ONLY to provision a new database for an
# "isolated"-mode tenant (CREATE DATABASE + loads the CRM schema into it).
# Needs CREATEDB privilege; point it at the "postgres" maintenance database
# on whatever Postgres server hosts isolated tenants — NOT the platform's
# own DATABASE_URL above. Leave unset to disable POST /api/provisioning/...
# ("dedicated"-mode tenants don't use this at all — see platform/README.md).
PROVISIONING_ADMIN_DATABASE_URL=

# The shared, multi-tenant Livanto CRM (crm/) this platform onboards
# tenants onto — see crm/src/app/api/platform/provision-tenant/route.ts.
# When both are set, creating a tenant here also provisions that tenant's
# actual CRM login (an "organizations" doc + its first admin account) —
# not just the tenant row in this database. CRM_PROVISION_SECRET must
# match that crm/ deploy's own PLATFORM_PROVISION_SECRET. Leave unset to
# skip CRM provisioning (a tenant row still gets created either way).
CRM_PROVISION_URL=http://localhost:3000
CRM_PROVISION_SECRET=
