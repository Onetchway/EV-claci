PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ev_csms
JWT_SECRET=your-super-secret-jwt-key-change-this
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ALLOWED_EMAIL_DOMAIN=zivahgroup.com
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Only set these if this CRM instance runs under the Livanto multi-tenant
# platform (see platform/) with per-employee billing. PLATFORM_TENANT_API_KEY
# is issued when the super admin onboards this tenant. See src/jobs/reportUsage.js.
PLATFORM_API_URL=
PLATFORM_TENANT_API_KEY=
