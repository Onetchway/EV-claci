PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ev_csms
JWT_SECRET=your-super-secret-jwt-key-change-this
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ALLOWED_EMAIL_DOMAIN=zivahgroup.com
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Only set these if this CRM instance runs under the Alpha multi-tenant
# platform (see platform/). PLATFORM_API_URL is used for two things:
#   - usage self-reporting for per-employee billing (src/jobs/reportUsage.js),
#     which also needs PLATFORM_TENANT_API_KEY (issued when the super admin
#     onboards this tenant)
#   - resolving which tenant an inbound request's Host header belongs to,
#     for a "shared" mode instance serving multiple tenants by subdomain or
#     custom domain (src/utils/resolveTenant.js, used at Google login)
# Leave both unset for a standalone/dedicated/isolated deploy.
PLATFORM_API_URL=
PLATFORM_TENANT_API_KEY=
