generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ENGINEER
}

enum FieldType {
  text
  number
  date
  select
  checkbox
  table
  photo
  file
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum StageStatus {
  LOCKED
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/// Which level(s) may set an override for a ConfigDef.
enum ConfigScope {
  CLIENT
  PROJECT
  BOTH
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  /// Legacy binary role — kept so existing V1 checks (`role === 'ADMIN'`) keep working unchanged.
  /// New authorization code should prefer `roleRef.rolePermissions`, kept in sync with this field.
  role         Role     @default(ENGINEER)
  roleId       String?
  roleRef      RoleDef? @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedProjects   Project[]       @relation("AssignedEngineer")
  submissions        Submission[]    @relation("SubmittedBy")
  approvedStages     ProjectStage[]  @relation("ApprovedBy")
  stageApprovals     StageApproval[] @relation("StageApprover")
  uploadedDocuments  Document[]      @relation("DocumentUploadedBy")
  projectMemberships ProjectMember[]
  auditLogs          AuditLog[]      @relation("AuditActor")

  @@map("users")
}

/// A configurable role (SUPER_ADMIN, OPERATIONS_MANAGER, FIELD_ENGINEER, ...) — see
/// docs/rbac.md. Seeded with a default permission matrix; intended to eventually be editable by
/// an admin UI without code changes.
model RoleDef {
  id       String  @id @default(cuid())
  key      String  @unique // e.g. "OPERATIONS_MANAGER"
  name     String // display name, e.g. "Operations Manager"
  isSystem Boolean @default(true) // seeded role vs a future custom role

  rolePermissions RolePermission[]
  users           User[]
  projectMembers  ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_defs")
}

/// A single grantable capability, e.g. "projects.viewAll", "stages.approve".
model PermissionDef {
  id          String @id @default(cuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  @@map("permission_defs")
}

model RolePermission {
  id           String        @id @default(cuid())
  roleId       String
  role         RoleDef       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   PermissionDef @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Project-scoped role assignment — replaces Project.assignedEngineerId as the source of truth
/// for "who can act on this project," while that column is kept for backward compatibility.
/// Enables multi-assignee projects (a PM + several engineers) and project-scoped permissions
/// (e.g. a Project Manager who can only approve stages on their own projects).
model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      RoleDef @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Append-only record of who changed what — never silently editable (no update/delete routes).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String // e.g. "project.create", "stage.approve"
  entityType String // e.g. "Project", "ProjectStage"
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageTemplates StageTemplate[]
  projects       Project[]
  configs        ClientConfig[]
  paymentMilestoneDefs PaymentMilestoneDef[]

  @@map("clients")
}

/// A configurable payment milestone for a client (e.g. "Civil Work Completion — 10%"),
/// replacing hardcoded per-client milestone logic. `ruleJson` describes when it's achieved:
///   { type: "statusIn", stageKeys: [...], statuses: [...] }        — every listed stage's
///     ProjectStage.status is one of `statuses`.
///   { type: "daysAfterStageApproval", stageKey, days, requiresMilestoneKey? } — `days` have
///     elapsed since `stageKey` was approved, optionally gated on another milestone (by key)
///     already being achieved.
model PaymentMilestoneDef {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  key     String
  label   String
  percent Float
  order   Int
  ruleJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
  @@map("payment_milestone_defs")
}

/// The registry of configurable settings — a config key's label/type/scope/default is defined
/// once here (seeded from src/config/configDefs.js), and ClientConfig/ProjectConfig rows are
/// just overrides on top of it. This is what lets admin-web render a config editor generically
/// and lets new phases add settings (SLAs, thresholds, branding, ...) without new tables.
model ConfigDef {
  id               String          @id @default(cuid())
  key              String          @unique // e.g. "pdf.footerText"
  label            String
  description      String
  valueType        ConfigValueType
  scope            ConfigScope
  defaultValueJson Json

  clientConfigs  ClientConfig[]
  projectConfigs ProjectConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config_defs")
}

/// A client-level override of a ConfigDef's default — applies to every project of that client
/// unless a ProjectConfig overrides it further.
model ClientConfig {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  configDefId String
  configDef   ConfigDef @relation(fields: [configDefId], references: [id], onDelete: Cascade)
  valueJson   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, configDefId])
  @@map("client_configs")
}

/// A project-level override of a ConfigDef's value — takes precedence over both ClientConfig and
/// the ConfigDef default. Only meaningful for ConfigDefs with scope PROJECT or BOTH.
model ProjectConfig {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configDefId String
  configDef   ConfigDef @relation(fields: [configDefId], references: [id], onDelete: Cascade)
  valueJson   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, configDefId])
  @@map("project_configs")
}

/// One row per work stage in a client's execution playbook (e.g. SURVEY, CIVIL, HOTO).
/// Order + fields are fully data-driven so a new client can be onboarded without code changes.
model StageTemplate {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  key   String // stable machine key, e.g. "CIVIL"
  name  String // display name, e.g. "Civil Work Execution"
  order Int // sequence within the client's playbook

  fieldDefs   FormFieldDef[]
  photoSlots  PhotoSlot[]
  projectStages ProjectStage[]

  /// Stages that must be APPROVED before this one unlocks (its prerequisites).
  dependsOn  StageDependency[] @relation("DependentStage")
  /// Stages that list this one as a prerequisite.
  dependents StageDependency[] @relation("PrerequisiteStage")

  approvalRule ApprovalRule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
  @@map("stage_templates")
}

/// Overrides the default single-approval-from-anyone-with-stages.approve behavior for one
/// StageTemplate. No row for a stage = requiredApprovals 1, eligibleRoleKeys [] (anyone
/// eligible) — today's exact behavior, so this is purely opt-in per stage.
model ApprovalRule {
  id                String        @id @default(cuid())
  stageTemplateId   String        @unique
  stageTemplate     StageTemplate @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  requiredApprovals Int           @default(1)
  /// RoleDef.key list; [] means anyone with the stages.approve permission on the project.
  eligibleRoleKeys  Json          @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_rules")
}

/// Self-referential prerequisite graph for StageTemplate: a stage can depend on zero, one, or
/// several prior stages, so parallel workstreams (e.g. two stages that both unlock a downstream
/// one only once both are approved) are expressible without hardcoding client-specific logic.
/// A stage with zero dependency rows is immediately workable when a project is created.
model StageDependency {
  id                  String        @id @default(cuid())
  stageTemplateId     String
  stageTemplate       StageTemplate @relation("DependentStage", fields: [stageTemplateId], references: [id], onDelete: Cascade)
  dependsOnTemplateId String
  dependsOnTemplate   StageTemplate @relation("PrerequisiteStage", fields: [dependsOnTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([stageTemplateId, dependsOnTemplateId])
  @@map("stage_dependencies")
}

/// A single form field within a stage's report form. `optionsJson` holds select options or,
/// for `table` fields, the row/column definition. `tableGroup` links related fields (e.g. an
/// item within a checklist group) for rendering.
model FormFieldDef {
  id              String    @id @default(cuid())
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)

  key         String
  label       String
  type        FieldType
  required    Boolean @default(false)
  order       Int
  groupLabel  String? // section heading in the form/PDF, e.g. "Company Documents"
  optionsJson Json? // e.g. { "options": ["LT","HT"] } or table row/column defs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stageTemplateId, key])
  @@map("form_field_defs")
}

/// A required geotagged-photo slot for a stage (e.g. "evcsFoundationFinished").
model PhotoSlot {
  id              String    @id @default(cuid())
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)

  key      String
  label    String
  required Boolean @default(true)
  order    Int

  photos Photo[]

  createdAt DateTime @default(now())

  @@unique([stageTemplateId, key])
  @@map("photo_slots")
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])

  siteName  String
  address   String
  lat       Float?
  lng       Float?
  status    ProjectStatus @default(ACTIVE)

  /// Legacy single-assignee field — kept for backward compatibility. New code should prefer
  /// `members` (ProjectMember), which supports multiple people with different project roles.
  assignedEngineerId String?
  assignedEngineer   User?   @relation("AssignedEngineer", fields: [assignedEngineerId], references: [id])

  stages  ProjectStage[]
  members ProjectMember[]
  configs ProjectConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

/// One instance of a StageTemplate for a specific Project — tracks progress/status.
model ProjectStage {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id])

  status       StageStatus @default(NOT_STARTED)
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  rejectionReason String?

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, stageTemplateId])
  @@map("project_stages")
}

/// The actual filled-in report for a ProjectStage. New submits after a rejection create a new
/// version rather than mutating history.
model Submission {
  id             String   @id @default(cuid())
  projectStageId String
  projectStage   ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)

  version      Int    @default(1)
  dataJson     Json // answers keyed by FormFieldDef.key
  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  pdfUrl String?

  photos    Photo[]
  approvals StageApproval[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("submissions")
}

/// A real uploaded file answering one FormFieldDef of type "file" — replaces the old stub where
/// a file field was just a boolean "attached?" flag in Submission.dataJson. Uploading a document
/// still sets dataJson[fieldKey] = true so the existing required-field submit validation (which
/// only checks dataJson truthiness) keeps working unchanged.
model Document {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fieldKey  String // the FormFieldDef.key (type "file") this document answers
  fileName  String // original filename, for display
  fileUrl   String
  mimeType  String?
  sizeBytes Int?

  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([submissionId, fieldKey])
  @@map("documents")
}

/// One approver's decision on one submission — a stage can require more than one before it's
/// fully APPROVED (see ApprovalRule). Scoped to the submission (not the stage) so a rejection
/// and resubmission starts a fresh approval round instead of carrying over stale decisions.
model StageApproval {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User     @relation("StageApprover", fields: [approverId], references: [id])
  decision     ApprovalDecision
  comment      String?

  createdAt DateTime @default(now())

  @@unique([submissionId, approverId])
  @@map("stage_approvals")
}

model Photo {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  photoSlotId  String
  photoSlot    PhotoSlot  @relation(fields: [photoSlotId], references: [id])

  originalUrl String
  stampedUrl  String?

  lat        Float
  lng        Float
  accuracyM  Float?
  address    String?
  capturedAt DateTime

  createdAt DateTime @default(now())

  @@map("photos")
}
