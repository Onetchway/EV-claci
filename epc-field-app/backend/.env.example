# Postgres connection (docker-compose default matches this)
DATABASE_URL="postgresql://epc:epc_dev_password@localhost:5433/epc_field_app?schema=public"

PORT=4100
NODE_ENV=development

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# File storage (local disk for MVP)
STORAGE_ROOT="./storage"
PUBLIC_BASE_URL="http://localhost:4100"

# Puppeteer — reuse the Chromium already installed in this environment instead of downloading one.
# On a machine without this pre-installed Chromium, point this at any Chrome/Chromium binary.
PUPPETEER_EXECUTABLE_PATH="/opt/pw-browsers/chromium"

# Reverse geocoding (OpenStreetMap Nominatim) — used to turn lat/lng into a human address for the
# geotag stamp burned onto photos. Set a descriptive UA per Nominatim's usage policy.
NOMINATIM_USER_AGENT="nakjm-epc-field-app/1.0 (contact: ops@nakjm.example)"
