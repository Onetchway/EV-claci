# Postgres connection (docker-compose default matches this)
DATABASE_URL="postgresql://epc:epc_dev_password@localhost:5433/epc_field_app?schema=public"

PORT=4100
NODE_ENV=development

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# File storage — "local" writes to disk under STORAGE_ROOT (default, used for local dev and
# anywhere with a persistent disk). "s3" uploads to any S3-compatible bucket (e.g. Cloudflare
# R2) instead — used in production, where the backend runs without a persistent disk.
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"
PUBLIC_BASE_URL="http://localhost:4100"

# Only used when STORAGE_DRIVER=s3 (see DEPLOYMENT.md for how to get these from Cloudflare R2):
# S3_ACCOUNT_ID=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_PUBLIC_BASE_URL="https://<bucket>.<account-id>.r2.dev"

# Comma-separated allowed browser origins. Leave unset for local dev (allows any origin).
# In production set to the admin dashboard's origin, e.g.:
# CORS_ORIGIN="https://dashboard.nakjminfra.com"
CORS_ORIGIN=

# Puppeteer — reuse the Chromium already installed in this environment instead of downloading one.
# On a machine without this pre-installed Chromium, point this at any Chrome/Chromium binary.
PUPPETEER_EXECUTABLE_PATH="/opt/pw-browsers/chromium"

# Reverse geocoding (OpenStreetMap Nominatim) — used to turn lat/lng into a human address for the
# geotag stamp burned onto photos. Set a descriptive UA per Nominatim's usage policy.
NOMINATIM_USER_AGENT="nakjm-epc-field-app/1.0 (contact: ops@nakjm.example)"
