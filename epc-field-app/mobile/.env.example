# Expo inlines EXPO_PUBLIC_* vars at build time (process.env.EXPO_PUBLIC_*).
# Local dev: point this at your backend's LAN IP — "localhost" will not work on a physical
# device or emulator since it resolves to the device itself, not your dev machine.
# e.g. http://192.168.1.50:4100/api
#
# Production builds (via `eas build`) should use the deployed backend instead:
# EXPO_PUBLIC_API_BASE_URL=https://api.nakjminfra.com/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4100/api
