# ---------------------------------------------------------------------------
# Firebase Web SDK — Project settings → General → Your apps → Web app → Config.
# These are public by design; access is controlled by the Firestore/Storage
# security rules in crm/firebase/, not by hiding these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local dev only — point the browser-side SDK at the Firebase emulator suite
# (see scripts/dev-setup-crm.sh) instead of a real Firebase project. Leave
# both unset for every real deployment. Must match FIRESTORE_EMULATOR_HOST /
# FIREBASE_AUTH_EMULATOR_HOST below, which do the same for the server-side
# Admin SDK.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# ---------------------------------------------------------------------------
# Firebase Admin SDK — Project settings → Service accounts → Generate new
# private key. Used only by the server routes that create users and set role
# claims. KEEP THIS SECRET; never prefix it with NEXT_PUBLIC_.
#
# Either paste the whole service-account JSON (or its base64 form):
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# ...or provide the three fields individually instead:
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email of the account that should be bootstrapped as SUPER_ADMIN by `npm run seed`.
SEED_SUPER_ADMIN_EMAIL=admin@livantogreen.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# Set to 1 to also insert a handful of demo leads when seeding.
SEED_DEMO_DATA=0

# ---------------------------------------------------------------------------
# Razorpay — Dashboard → Settings → API Keys. Enables wallet top-ups
# (User Management → Top up) via Razorpay Checkout. KEEP THE SECRET KEY
# SECRET; never prefix it with NEXT_PUBLIC_. Without these two set, the
# top-up button returns a clear "not configured" error instead of failing
# silently.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Alpha platform — only set if this CRM instance is a tenant onboarded onto
# the Alpha super-admin platform (see ../platform/). PLATFORM_TENANT_API_KEY
# is issued when the super admin onboards this tenant. Powers
# `npm run report-usage` (see scripts/report-usage.ts), which pushes this
# tenant's active-user count for per-employee billing — the only thing this
# CRM instance ever sends to the platform. Leave both unset for a standalone
# deploy.
# ---------------------------------------------------------------------------
PLATFORM_API_URL=
PLATFORM_TENANT_API_KEY=

# The reverse direction: lets the Alpha platform provision a brand new
# tenant's org + first admin login on THIS shared CRM instance the moment a
# super admin creates them (see api/platform/provision-tenant/route.ts) —
# no signed-in user exists yet at that point, so this shared secret is the
# only thing authenticating that call instead of a Firebase ID token. Must
# match the platform's own CRM_PROVISION_SECRET (platform/backend/.env).
# Leave unset to disable that route entirely.
PLATFORM_PROVISION_SECRET=
