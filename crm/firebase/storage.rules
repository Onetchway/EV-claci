rules_version = '2';

// Lead documents (Aadhaar, PAN, load sanction letters, site photos).
//
// Storage rules cannot read Firestore, so ownership cannot be checked here.
// Access is therefore gated on being a signed-in CRM user, and the Firestore
// `documents` sub-collection — which is properly owner-scoped — is the only
// place download URLs are ever surfaced.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'AGENT';
    }

    function isAdmin() {
      return role() in ['ADMIN', 'SUPER_ADMIN', 'OPERATIONS'];
    }

    // Same bar as the Firestore users/{userId}/documents rule (see
    // firestore.rules) — salary data's bar, Finance/Admin/Super Admin only.
    function canManagePayroll() {
      return role() in ['SUPER_ADMIN', 'ADMIN', 'FINANCE'];
    }

    function acceptableFile() {
      return request.resource.size < 15 * 1024 * 1024
             && (request.resource.contentType.matches('image/.*')
                 || request.resource.contentType == 'application/pdf');
    }

    match /leads/{leadId}/{kind}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && acceptableFile();
      // Files are immutable once uploaded; a correction is a new upload.
      allow update: if false;
      allow delete: if isAdmin()
                    || (signedIn() && resource.metadata.uploadedBy == request.auth.uid);
    }

    // Project site-progress photos (see projects/{id}/photos in Firestore).
    // Same posture as leads/** above: Storage can't check Firestore
    // ownership, so this is gated on being signed in generally, and the
    // investor portal only ever learns a photo's path through its own
    // Firestore-side, ownership-scoped read of that subcollection.
    match /projects/{projectId}/{kind}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && acceptableFile();
      allow update: if false;
      allow delete: if isAdmin()
                    || (signedIn() && resource.metadata.uploadedBy == request.auth.uid);
    }

    match /tickets/{ticketId}/{fileName} {
      allow read: if signedIn();
      allow create: if role() in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'] && acceptableFile();
      allow update: if false;
      allow delete: if role() in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'];
    }

    match /chargers/{chargerId}/{fileName} {
      allow read: if signedIn();
      allow create: if role() in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'] && acceptableFile();
      allow update: if false;
      allow delete: if role() in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'];
    }

    // An employee's own KYC documents (Aadhaar, PAN, address proof, ...) —
    // see src/lib/db/employee-documents.ts. Same bar as salary data
    // (Finance/Admin/Super Admin) for upload/delete; the employee whose
    // record this is may additionally read their own file — Storage can't
    // check Firestore, so "own" is read straight off the path's {uid}
    // segment against the caller's uid, same mechanism as role() above
    // (the ID token's custom claims), not a Firestore cross-reference.
    match /employees/{uid}/{kind}/{fileName} {
      allow read: if canManagePayroll() || (signedIn() && request.auth.uid == uid);
      allow create: if canManagePayroll() && acceptableFile();
      allow update: if false;
      allow delete: if canManagePayroll();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
