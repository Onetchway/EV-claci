NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Optional — Google OAuth. Leave unset to use email/password login only
# (see src/app/(auth)/login/page.js and backend/src/services/auth.service.js).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

NEXT_PUBLIC_API_URL=http://localhost:5000/api
ALLOWED_EMAIL_DOMAIN=zivahgroup.com

# Path-based multi-tenancy — set both to 1 to serve every tenant off one
# domain by URL path (app.alpha.com/xpulse) instead of a subdomain/custom
# domain per tenant. See middleware.js and src/lib/tenant.js. Leave unset
# for a standalone or subdomain-routed deploy (e.g. Livanto's own domain).
MULTI_TENANT_PATH_MODE=0
NEXT_PUBLIC_MULTI_TENANT_PATH_MODE=0
